# Local dev override (EXAMPLE). Copy to `docker-compose.override.yml` (gitignored)
# and fill in YOUR dev-server origins. `docker compose up` auto-loads
# docker-compose.override.yml on every run, so keep it local — personal
# worktree ports must never leak into everyone else's stack.
services:
  api-gateway:
    environment:
      # Frontend dev origin(s) allowed by CORS. Add your own non-3000 worktree
      # port, e.g.: http://localhost:3000,http://localhost:<your-dev-port>
      - RSYNC_CORS_ORIGINS=http://localhost:3000
  # Expose tool-generator to the host for the Playwright specs' /health
  # checks (frontend/e2e/*.spec.ts, server-side requests). The browser never
  # calls it: the UI goes through the api-gateway's /api/v1/tool-generator
  # proxy, and the service allows no browser origin.
  tool-generator:
    ports:
      - "127.0.0.1:5010:5010"
