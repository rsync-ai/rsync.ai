# settings: {"version":2,"type":"bar","roles":{"x":[{"column":"day","grain":"month"}],"measure":[{"aggregate":"sum","column":"amount","mark":"bar","axis":"left"},{"aggregate":"count","mark":"line","axis":"right"}]}}

-- postgres
SELECT DATE_TRUNC('month', src."day") AS "day", SUM(src."amount") AS "amount", COUNT(*) AS "count"
FROM "gold"."orders" src
WHERE src."day" >= $1 AND src."day" < $2 AND src."region" IN ($3, $4)
GROUP BY DATE_TRUNC('month', src."day")
ORDER BY DATE_TRUNC('month', src."day") ASC
LIMIT 10001
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- mysql
SELECT MAKEDATE(YEAR(src.`day`), 1) + INTERVAL (MONTH(src.`day`) - 1) MONTH AS `day`, SUM(src.`amount`) AS `amount`, COUNT(*) AS `count`
FROM `gold`.`orders` src
WHERE src.`day` >= ? AND src.`day` < ? AND src.`region` IN (?, ?)
GROUP BY MAKEDATE(YEAR(src.`day`), 1) + INTERVAL (MONTH(src.`day`) - 1) MONTH
ORDER BY MAKEDATE(YEAR(src.`day`), 1) + INTERVAL (MONTH(src.`day`) - 1) MONTH ASC
LIMIT 10001
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- sqlserver
SELECT TOP (10001) DATEFROMPARTS(YEAR(src.[day]), MONTH(src.[day]), 1) AS [day], SUM(src.[amount]) AS [amount], COUNT_BIG(*) AS [count]
FROM [gold].[orders] src
WHERE src.[day] >= @p1 AND src.[day] < @p2 AND src.[region] IN (@p3, @p4)
GROUP BY DATEFROMPARTS(YEAR(src.[day]), MONTH(src.[day]), 1)
ORDER BY DATEFROMPARTS(YEAR(src.[day]), MONTH(src.[day]), 1) ASC
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- bigquery
SELECT DATE_TRUNC(DATE(src.`day`), MONTH) AS `day`, SUM(src.`amount`) AS `amount`, COUNT(*) AS `count`
FROM `gold`.`orders` src
GROUP BY DATE_TRUNC(DATE(src.`day`), MONTH)
ORDER BY DATE_TRUNC(DATE(src.`day`), MONTH) ASC
LIMIT 10001
-- unfiltered: day, region

-- snowflake
SELECT DATE_TRUNC('MONTH', src."DAY") AS "DAY", SUM(src."AMOUNT") AS "AMOUNT", COUNT(*) AS "COUNT"
FROM "GOLD"."ORDERS" src
GROUP BY DATE_TRUNC('MONTH', src."DAY")
ORDER BY DATE_TRUNC('MONTH', src."DAY") ASC
LIMIT 10001
-- unfiltered: day, region

-- databricks
SELECT DATE_TRUNC('MONTH', src.`day`) AS `day`, SUM(src.`amount`) AS `amount`, COUNT(*) AS `count`
FROM `gold`.`orders` src
WHERE src.`day` >= :p1 AND src.`day` < :p2 AND src.`region` IN (:p3, :p4)
GROUP BY DATE_TRUNC('MONTH', src.`day`)
ORDER BY DATE_TRUNC('MONTH', src.`day`) ASC
LIMIT 10001
-- param p1 STRING: "2026-10-01"
-- param p2 STRING: "2026-10-06"
-- param p3 STRING: "US"
-- param p4 STRING: "EU'); DROP TABLE orders; --"

-- clickhouse
SELECT toStartOfMonth(src.`day`) AS `day`, SUM(src.`amount`) AS `amount`, COUNT(*) AS `count`
FROM `gold`.`orders` src
GROUP BY toStartOfMonth(src.`day`)
ORDER BY toStartOfMonth(src.`day`) ASC
LIMIT 10001
-- unfiltered: day, region

-- oracle
SELECT TRUNC(src."DAY", 'MM') AS "DAY", SUM(src."AMOUNT") AS "AMOUNT", COUNT(*) AS "COUNT"
FROM "GOLD"."ORDERS" src
GROUP BY TRUNC(src."DAY", 'MM')
ORDER BY TRUNC(src."DAY", 'MM') ASC
FETCH FIRST 10001 ROWS ONLY
-- unfiltered: day, region
