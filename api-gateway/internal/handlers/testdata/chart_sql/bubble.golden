# settings: {"version":2,"type":"bubble","roles":{"x":[{"column":"amount"}],"y":[{"column":"quantity"}],"size":[{"column":"discount"}]}}

-- postgres
SELECT src."amount" AS "amount", src."quantity" AS "quantity", src."discount" AS "discount", COUNT(*) AS "rsync_rows"
FROM "gold"."orders" src
WHERE src."amount" IS NOT NULL AND src."quantity" IS NOT NULL AND src."discount" > 0 AND src."day" >= $1 AND src."day" < $2 AND src."region" IN ($3, $4)
GROUP BY src."amount", src."quantity", src."discount"
ORDER BY COUNT(*) DESC, src."amount" ASC, src."quantity" ASC, src."discount" ASC
LIMIT 10001
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- mysql
SELECT src.`amount` AS `amount`, src.`quantity` AS `quantity`, src.`discount` AS `discount`, COUNT(*) AS `rsync_rows`
FROM `gold`.`orders` src
WHERE src.`amount` IS NOT NULL AND src.`quantity` IS NOT NULL AND src.`discount` > 0 AND src.`day` >= ? AND src.`day` < ? AND src.`region` IN (?, ?)
GROUP BY src.`amount`, src.`quantity`, src.`discount`
ORDER BY COUNT(*) DESC, src.`amount` ASC, src.`quantity` ASC, src.`discount` ASC
LIMIT 10001
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- sqlserver
SELECT TOP (10001) src.[amount] AS [amount], src.[quantity] AS [quantity], src.[discount] AS [discount], COUNT_BIG(*) AS [rsync_rows]
FROM [gold].[orders] src
WHERE src.[amount] IS NOT NULL AND src.[quantity] IS NOT NULL AND src.[discount] > 0 AND src.[day] >= @p1 AND src.[day] < @p2 AND src.[region] IN (@p3, @p4)
GROUP BY src.[amount], src.[quantity], src.[discount]
ORDER BY COUNT_BIG(*) DESC, src.[amount] ASC, src.[quantity] ASC, src.[discount] ASC
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- bigquery
SELECT src.`amount` AS `amount`, src.`quantity` AS `quantity`, src.`discount` AS `discount`, COUNT(*) AS `rsync_rows`
FROM `gold`.`orders` src
WHERE src.`amount` IS NOT NULL AND src.`quantity` IS NOT NULL AND src.`discount` > 0
GROUP BY src.`amount`, src.`quantity`, src.`discount`
ORDER BY COUNT(*) DESC, src.`amount` ASC, src.`quantity` ASC, src.`discount` ASC
LIMIT 10001
-- unfiltered: day, region

-- snowflake
SELECT src."AMOUNT" AS "AMOUNT", src."QUANTITY" AS "QUANTITY", src."DISCOUNT" AS "DISCOUNT", COUNT(*) AS "RSYNC_ROWS"
FROM "GOLD"."ORDERS" src
WHERE src."AMOUNT" IS NOT NULL AND src."QUANTITY" IS NOT NULL AND src."DISCOUNT" > 0
GROUP BY src."AMOUNT", src."QUANTITY", src."DISCOUNT"
ORDER BY COUNT(*) DESC, src."AMOUNT" ASC, src."QUANTITY" ASC, src."DISCOUNT" ASC
LIMIT 10001
-- unfiltered: day, region

-- databricks
SELECT src.`amount` AS `amount`, src.`quantity` AS `quantity`, src.`discount` AS `discount`, COUNT(*) AS `rsync_rows`
FROM `gold`.`orders` src
WHERE src.`amount` IS NOT NULL AND src.`quantity` IS NOT NULL AND src.`discount` > 0 AND src.`day` >= :p1 AND src.`day` < :p2 AND src.`region` IN (:p3, :p4)
GROUP BY src.`amount`, src.`quantity`, src.`discount`
ORDER BY COUNT(*) DESC, src.`amount` ASC, src.`quantity` ASC, src.`discount` ASC
LIMIT 10001
-- param p1 STRING: "2026-10-01"
-- param p2 STRING: "2026-10-06"
-- param p3 STRING: "US"
-- param p4 STRING: "EU'); DROP TABLE orders; --"

-- clickhouse
SELECT src.`amount` AS `amount`, src.`quantity` AS `quantity`, src.`discount` AS `discount`, COUNT(*) AS `rsync_rows`
FROM `gold`.`orders` src
WHERE src.`amount` IS NOT NULL AND src.`quantity` IS NOT NULL AND src.`discount` > 0
GROUP BY src.`amount`, src.`quantity`, src.`discount`
ORDER BY COUNT(*) DESC, src.`amount` ASC, src.`quantity` ASC, src.`discount` ASC
LIMIT 10001
-- unfiltered: day, region

-- oracle
SELECT src."AMOUNT" AS "AMOUNT", src."QUANTITY" AS "QUANTITY", src."DISCOUNT" AS "DISCOUNT", COUNT(*) AS "RSYNC_ROWS"
FROM "GOLD"."ORDERS" src
WHERE src."AMOUNT" IS NOT NULL AND src."QUANTITY" IS NOT NULL AND src."DISCOUNT" > 0
GROUP BY src."AMOUNT", src."QUANTITY", src."DISCOUNT"
ORDER BY COUNT(*) DESC, src."AMOUNT" ASC, src."QUANTITY" ASC, src."DISCOUNT" ASC
FETCH FIRST 10001 ROWS ONLY
-- unfiltered: day, region
