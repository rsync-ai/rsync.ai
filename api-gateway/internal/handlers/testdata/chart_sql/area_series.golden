-- snowflake
SELECT r."DAY" AS "DAY", CASE WHEN r."RSYNC_RANK" <= 7 THEN r."REGION" END AS "REGION", MAX(r."AMOUNT") AS "AMOUNT", CASE WHEN r."RSYNC_RANK" <= 7 THEN 0 ELSE 1 END AS "RSYNC_OTHER", MAX(MAX(r."RSYNC_RANK")) OVER () AS "RSYNC_SERIES"
FROM (
SELECT g."DAY", g."REGION", g."AMOUNT", DENSE_RANK() OVER (ORDER BY CASE WHEN g."RSYNC_TOTAL" IS NULL THEN 1 ELSE 0 END, g."RSYNC_TOTAL" DESC, g."REGION" ASC) AS "RSYNC_RANK"
FROM (
SELECT src."DAY" AS "DAY", src."REGION" AS "REGION", MAX(src."AMOUNT") AS "AMOUNT", MAX(MAX(src."AMOUNT")) OVER (PARTITION BY src."REGION") AS "RSYNC_TOTAL"
FROM "GOLD"."ORDERS" src
GROUP BY src."DAY", src."REGION"
) g
) r
GROUP BY r."DAY", CASE WHEN r."RSYNC_RANK" <= 7 THEN r."REGION" END, CASE WHEN r."RSYNC_RANK" <= 7 THEN 0 ELSE 1 END
ORDER BY r."DAY" DESC, CASE WHEN r."RSYNC_RANK" <= 7 THEN r."REGION" END ASC, CASE WHEN r."RSYNC_RANK" <= 7 THEN 0 ELSE 1 END ASC
LIMIT 10001
-- unfiltered: day, region

