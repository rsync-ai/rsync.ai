# settings: {"version":2,"type":"sunburst","roles":{"rows":[{"column":"channel"},{"column":"region"},{"column":"customer_id"}],"measure":[{"aggregate":"count"}]}}

-- postgres
SELECT src."channel" AS "channel", src."region" AS "region", src."customer_id" AS "customer_id", COUNT(*) AS "count"
FROM "gold"."orders" src
WHERE src."day" >= $1 AND src."day" < $2 AND src."region" IN ($3, $4)
GROUP BY src."channel", src."region", src."customer_id"
ORDER BY COUNT(*) DESC, src."channel" ASC, src."region" ASC, src."customer_id" ASC
LIMIT 3501
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- mysql
SELECT src.`channel` AS `channel`, src.`region` AS `region`, src.`customer_id` AS `customer_id`, COUNT(*) AS `count`
FROM `gold`.`orders` src
WHERE src.`day` >= ? AND src.`day` < ? AND src.`region` IN (?, ?)
GROUP BY src.`channel`, src.`region`, src.`customer_id`
ORDER BY COUNT(*) DESC, src.`channel` ASC, src.`region` ASC, src.`customer_id` ASC
LIMIT 3501
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- sqlserver
SELECT TOP (3501) src.[channel] AS [channel], src.[region] AS [region], src.[customer_id] AS [customer_id], COUNT_BIG(*) AS [count]
FROM [gold].[orders] src
WHERE src.[day] >= @p1 AND src.[day] < @p2 AND src.[region] IN (@p3, @p4)
GROUP BY src.[channel], src.[region], src.[customer_id]
ORDER BY COUNT_BIG(*) DESC, src.[channel] ASC, src.[region] ASC, src.[customer_id] ASC
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- bigquery
SELECT src.`channel` AS `channel`, src.`region` AS `region`, src.`customer_id` AS `customer_id`, COUNT(*) AS `count`
FROM `gold`.`orders` src
GROUP BY src.`channel`, src.`region`, src.`customer_id`
ORDER BY COUNT(*) DESC, src.`channel` ASC, src.`region` ASC, src.`customer_id` ASC
LIMIT 3501
-- unfiltered: day, region

-- snowflake
SELECT src."CHANNEL" AS "CHANNEL", src."REGION" AS "REGION", src."CUSTOMER_ID" AS "CUSTOMER_ID", COUNT(*) AS "COUNT"
FROM "GOLD"."ORDERS" src
GROUP BY src."CHANNEL", src."REGION", src."CUSTOMER_ID"
ORDER BY COUNT(*) DESC, src."CHANNEL" ASC, src."REGION" ASC, src."CUSTOMER_ID" ASC
LIMIT 3501
-- unfiltered: day, region

-- databricks
SELECT src.`channel` AS `channel`, src.`region` AS `region`, src.`customer_id` AS `customer_id`, COUNT(*) AS `count`
FROM `gold`.`orders` src
WHERE src.`day` >= :p1 AND src.`day` < :p2 AND src.`region` IN (:p3, :p4)
GROUP BY src.`channel`, src.`region`, src.`customer_id`
ORDER BY COUNT(*) DESC, src.`channel` ASC, src.`region` ASC, src.`customer_id` ASC
LIMIT 3501
