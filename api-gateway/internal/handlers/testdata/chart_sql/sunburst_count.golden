-- clickhouse
SELECT src.`channel` AS `channel`, src.`region` AS `region`, src.`customer_id` AS `customer_id`, COUNT(*) AS `count`
FROM `gold`.`orders` src
GROUP BY src.`channel`, src.`region`, src.`customer_id`
ORDER BY COUNT(*) DESC, src.`channel` ASC, src.`region` ASC, src.`customer_id` ASC
LIMIT 3501
