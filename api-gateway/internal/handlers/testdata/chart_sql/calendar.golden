# settings: {"version":2,"type":"calendar","roles":{"x":[{"column":"day"}],"measure":[{"aggregate":"avg","column":"amount"}]}}

-- postgres
SELECT DATE_TRUNC('day', src."day") AS "day", AVG(src."amount") AS "amount"
FROM "gold"."orders" src
WHERE src."day" >= $1 AND src."day" < $2 AND src."region" IN ($3, $4)
GROUP BY DATE_TRUNC('day', src."day")
ORDER BY DATE_TRUNC('day', src."day") DESC
LIMIT 367
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- mysql
SELECT DATE(src.`day`) AS `day`, AVG(src.`amount`) AS `amount`
FROM `gold`.`orders` src
WHERE src.`day` >= ? AND src.`day` < ? AND src.`region` IN (?, ?)
GROUP BY DATE(src.`day`)
ORDER BY DATE(src.`day`) DESC
LIMIT 367
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- sqlserver
SELECT TOP (367) CAST(src.[day] AS date) AS [day], AVG(src.[amount]) AS [amount]
FROM [gold].[orders] src
WHERE src.[day] >= @p1 AND src.[day] < @p2 AND src.[region] IN (@p3, @p4)
GROUP BY CAST(src.[day] AS date)
ORDER BY CAST(src.[day] AS date) DESC
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- bigquery
SELECT DATE(src.`day`) AS `day`, AVG(src.`amount`) AS `amount`
FROM `gold`.`orders` src
GROUP BY DATE(src.`day`)
ORDER BY DATE(src.`day`) DESC
LIMIT 367
-- unfiltered: day, region

-- snowflake
SELECT DATE_TRUNC('DAY', src."DAY") AS "DAY", AVG(src."AMOUNT") AS "AMOUNT"
FROM "GOLD"."ORDERS" src
GROUP BY DATE_TRUNC('DAY', src."DAY")
ORDER BY DATE_TRUNC('DAY', src."DAY") DESC
LIMIT 367
-- unfiltered: day, region

-- databricks
SELECT DATE_TRUNC('DAY', src.`day`) AS `day`, AVG(src.`amount`) AS `amount`
FROM `gold`.`orders` src
WHERE src.`day` >= :p1 AND src.`day` < :p2 AND src.`region` IN (:p3, :p4)
GROUP BY DATE_TRUNC('DAY', src.`day`)
ORDER BY DATE_TRUNC('DAY', src.`day`) DESC
LIMIT 367
-- param p1 STRING: "2026-10-01"
-- param p2 STRING: "2026-10-06"
-- param p3 STRING: "US"
-- param p4 STRING: "EU'); DROP TABLE orders; --"

-- clickhouse
SELECT toDate(src.`day`) AS `day`, AVG(src.`amount`) AS `amount`
FROM `gold`.`orders` src
GROUP BY toDate(src.`day`)
ORDER BY toDate(src.`day`) DESC
LIMIT 367
-- unfiltered: day, region

-- oracle
SELECT TRUNC(src."DAY", 'DD') AS "DAY", AVG(src."AMOUNT") AS "AMOUNT"
FROM "GOLD"."ORDERS" src
GROUP BY TRUNC(src."DAY", 'DD')
ORDER BY TRUNC(src."DAY", 'DD') DESC
FETCH FIRST 367 ROWS ONLY
-- unfiltered: day, region
