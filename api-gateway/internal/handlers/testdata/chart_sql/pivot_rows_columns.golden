-- clickhouse
SELECT p.`region`, p.`day`, p.`channel`, p.`amount`, p.`amount_2`, p.`count`, p.`rsync_total_r1`, p.`rsync_total_r2`, p.`rsync_total_c1`
FROM (
SELECT src.`region` AS `region`, toStartOfMonth(src.`day`) AS `day`, src.`channel` AS `channel`, SUM(src.`amount`) AS `amount`, AVG(src.`amount`) AS `amount_2`, COUNT(*) AS `count`, GROUPING(src.`region`) AS `rsync_total_r1`, GROUPING(toStartOfMonth(src.`day`)) AS `rsync_total_r2`, GROUPING(src.`channel`) AS `rsync_total_c1`
FROM `gold`.`orders` src
GROUP BY GROUPING SETS ((src.`region`, toStartOfMonth(src.`day`), src.`channel`), (src.`region`, toStartOfMonth(src.`day`)), (src.`region`, src.`channel`), (src.`region`), (src.`channel`), ())
) p
ORDER BY p.`rsync_total_r1` + p.`rsync_total_r2` + p.`rsync_total_c1` DESC, p.`rsync_total_r1` DESC, p.`rsync_total_r2` DESC, p.`rsync_total_c1` DESC, p.`region` ASC, p.`day` ASC, p.`channel` ASC
LIMIT 10001
-- unfiltered: day, region

-- oracle
SELECT p."REGION", p."DAY", p."CHANNEL", p."AMOUNT", p."AMOUNT_2", p."COUNT", p."RSYNC_TOTAL_R1", p."RSYNC_TOTAL_R2", p."RSYNC_TOTAL_C1"
FROM (
SELECT src."REGION" AS "REGION", TRUNC(src."DAY", 'MM') AS "DAY", src."CHANNEL" AS "CHANNEL", SUM(src."AMOUNT") AS "AMOUNT", AVG(src."AMOUNT") AS "AMOUNT_2", COUNT(*) AS "COUNT", GROUPING(src."REGION") AS "RSYNC_TOTAL_R1", GROUPING(TRUNC(src."DAY", 'MM')) AS "RSYNC_TOTAL_R2", GROUPING(src."CHANNEL") AS "RSYNC_TOTAL_C1"
FROM "GOLD"."ORDERS" src
GROUP BY GROUPING SETS ((src."REGION", TRUNC(src."DAY", 'MM'), src."CHANNEL"), (src."REGION", TRUNC(src."DAY", 'MM')), (src."REGION", src."CHANNEL"), (src."REGION"), (src."CHANNEL"), ())
) p
ORDER BY p."RSYNC_TOTAL_R1" + p."RSYNC_TOTAL_R2" + p."RSYNC_TOTAL_C1" DESC, p."RSYNC_TOTAL_R1" DESC, p."RSYNC_TOTAL_R2" DESC, p."RSYNC_TOTAL_C1" DESC, p."REGION" ASC, p."DAY" ASC, p."CHANNEL" ASC
FETCH FIRST 10001 ROWS ONLY
