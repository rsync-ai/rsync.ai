-- databricks
SELECT p.`region`, p.`day`, p.`channel`, p.`amount`, p.`amount_2`, p.`count`, p.`rsync_total_r1`, p.`rsync_total_r2`, p.`rsync_total_c1`
FROM (
SELECT src.`region` AS `region`, DATE_TRUNC('MONTH', src.`day`) AS `day`, src.`channel` AS `channel`, SUM(src.`amount`) AS `amount`, AVG(src.`amount`) AS `amount_2`, COUNT(*) AS `count`, GROUPING(src.`region`) AS `rsync_total_r1`, GROUPING(DATE_TRUNC('MONTH', src.`day`)) AS `rsync_total_r2`, GROUPING(src.`channel`) AS `rsync_total_c1`
FROM `gold`.`orders` src
WHERE src.`day` >= :p1 AND src.`day` < :p2 AND src.`region` IN (:p3, :p4)
GROUP BY GROUPING SETS ((src.`region`, DATE_TRUNC('MONTH', src.`day`), src.`channel`), (src.`region`, DATE_TRUNC('MONTH', src.`day`)), (src.`region`, src.`channel`), (src.`region`), (src.`channel`), ())
