# settings: {"version":2,"type":"line","roles":{"x":[{"column":"day","grain":"week"}],"measure":[{"aggregate":"sum","column":"amount"}]}}

-- postgres
SELECT DATE_TRUNC('week', src."day" + INTERVAL '1 days') - INTERVAL '1 days' AS "day", SUM(src."amount") AS "amount"
FROM "gold"."orders" src
WHERE src."day" >= $1 AND src."day" < $2 AND src."region" IN ($3, $4)
GROUP BY DATE_TRUNC('week', src."day" + INTERVAL '1 days') - INTERVAL '1 days'
ORDER BY DATE_TRUNC('week', src."day" + INTERVAL '1 days') - INTERVAL '1 days' ASC
LIMIT 10001
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- mysql
SELECT DATE_SUB(DATE(src.`day`), INTERVAL MOD(WEEKDAY(src.`day`) + 1, 7) DAY) AS `day`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
WHERE src.`day` >= ? AND src.`day` < ? AND src.`region` IN (?, ?)
GROUP BY DATE_SUB(DATE(src.`day`), INTERVAL MOD(WEEKDAY(src.`day`) + 1, 7) DAY)
ORDER BY DATE_SUB(DATE(src.`day`), INTERVAL MOD(WEEKDAY(src.`day`) + 1, 7) DAY) ASC
LIMIT 10001
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- sqlserver
SELECT TOP (10001) DATEADD(day, -((DATEDIFF(day, '19000107', src.[day]) % 7 + 7) % 7), CAST(src.[day] AS date)) AS [day], SUM(src.[amount]) AS [amount]
FROM [gold].[orders] src
WHERE src.[day] >= @p1 AND src.[day] < @p2 AND src.[region] IN (@p3, @p4)
GROUP BY DATEADD(day, -((DATEDIFF(day, '19000107', src.[day]) % 7 + 7) % 7), CAST(src.[day] AS date))
ORDER BY DATEADD(day, -((DATEDIFF(day, '19000107', src.[day]) % 7 + 7) % 7), CAST(src.[day] AS date)) ASC
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- bigquery
SELECT DATE_TRUNC(DATE(src.`day`), WEEK(SUNDAY)) AS `day`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
GROUP BY DATE_TRUNC(DATE(src.`day`), WEEK(SUNDAY))
ORDER BY DATE_TRUNC(DATE(src.`day`), WEEK(SUNDAY)) ASC
LIMIT 10001
-- unfiltered: day, region

-- snowflake
SELECT DATEADD('DAY', -MOD(DAYOFWEEKISO(src."DAY") + 0, 7), DATE_TRUNC('DAY', src."DAY")) AS "DAY", SUM(src."AMOUNT") AS "AMOUNT"
FROM "GOLD"."ORDERS" src
GROUP BY DATEADD('DAY', -MOD(DAYOFWEEKISO(src."DAY") + 0, 7), DATE_TRUNC('DAY', src."DAY"))
ORDER BY DATEADD('DAY', -MOD(DAYOFWEEKISO(src."DAY") + 0, 7), DATE_TRUNC('DAY', src."DAY")) ASC
LIMIT 10001
-- unfiltered: day, region

-- databricks
SELECT DATE_TRUNC('WEEK', src.`day` + INTERVAL 1 DAYS) - INTERVAL 1 DAYS AS `day`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
WHERE src.`day` >= :p1 AND src.`day` < :p2 AND src.`region` IN (:p3, :p4)
GROUP BY DATE_TRUNC('WEEK', src.`day` + INTERVAL 1 DAYS) - INTERVAL 1 DAYS
ORDER BY DATE_TRUNC('WEEK', src.`day` + INTERVAL 1 DAYS) - INTERVAL 1 DAYS ASC
LIMIT 10001
-- param p1 STRING: "2026-10-01"
-- param p2 STRING: "2026-10-06"
-- param p3 STRING: "US"
-- param p4 STRING: "EU'); DROP TABLE orders; --"

-- clickhouse
SELECT toDate(src.`day`) - ((toDayOfWeek(src.`day`) + 0) % 7) AS `day`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
GROUP BY toDate(src.`day`) - ((toDayOfWeek(src.`day`) + 0) % 7)
ORDER BY toDate(src.`day`) - ((toDayOfWeek(src.`day`) + 0) % 7) ASC
LIMIT 10001
-- unfiltered: day, region

-- oracle
SELECT TRUNC(src."DAY" + 1, 'IW') - 1 AS "DAY", SUM(src."AMOUNT") AS "AMOUNT"
FROM "GOLD"."ORDERS" src
GROUP BY TRUNC(src."DAY" + 1, 'IW') - 1
ORDER BY TRUNC(src."DAY" + 1, 'IW') - 1 ASC
FETCH FIRST 10001 ROWS ONLY
-- unfiltered: day, region
