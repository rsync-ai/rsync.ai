# settings: {"version":2,"type":"treemap","roles":{"rows":[{"column":"region"},{"column":"channel"}],"measure":[{"aggregate":"sum","column":"amount"}]}}

-- postgres
SELECT src."region" AS "region", src."channel" AS "channel", SUM(src."amount") AS "amount"
FROM "gold"."orders" src
WHERE src."day" >= $1 AND src."day" < $2 AND src."region" IN ($3, $4)
GROUP BY src."region", src."channel"
ORDER BY SUM(src."amount") DESC, src."region" ASC, src."channel" ASC
LIMIT 3501
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- mysql
SELECT src.`region` AS `region`, src.`channel` AS `channel`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
WHERE src.`day` >= ? AND src.`day` < ? AND src.`region` IN (?, ?)
GROUP BY src.`region`, src.`channel`
ORDER BY SUM(src.`amount`) DESC, src.`region` ASC, src.`channel` ASC
LIMIT 3501
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- sqlserver
SELECT TOP (3501) src.[region] AS [region], src.[channel] AS [channel], SUM(src.[amount]) AS [amount]
FROM [gold].[orders] src
WHERE src.[day] >= @p1 AND src.[day] < @p2 AND src.[region] IN (@p3, @p4)
GROUP BY src.[region], src.[channel]
ORDER BY SUM(src.[amount]) DESC, src.[region] ASC, src.[channel] ASC
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- bigquery
SELECT src.`region` AS `region`, src.`channel` AS `channel`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
GROUP BY src.`region`, src.`channel`
ORDER BY SUM(src.`amount`) DESC, src.`region` ASC, src.`channel` ASC
LIMIT 3501
-- unfiltered: day, region

-- snowflake
SELECT src."REGION" AS "REGION", src."CHANNEL" AS "CHANNEL", SUM(src."AMOUNT") AS "AMOUNT"
FROM "GOLD"."ORDERS" src
GROUP BY src."REGION", src."CHANNEL"
ORDER BY SUM(src."AMOUNT") DESC, src."REGION" ASC, src."CHANNEL" ASC
LIMIT 3501
-- unfiltered: day, region

-- databricks
SELECT src.`region` AS `region`, src.`channel` AS `channel`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
WHERE src.`day` >= :p1 AND src.`day` < :p2 AND src.`region` IN (:p3, :p4)
GROUP BY src.`region`, src.`channel`
ORDER BY SUM(src.`amount`) DESC, src.`region` ASC, src.`channel` ASC
LIMIT 3501
-- param p1 STRING: "2026-10-01"
-- param p2 STRING: "2026-10-06"
-- param p3 STRING: "US"
-- param p4 STRING: "EU'); DROP TABLE orders; --"

-- clickhouse
SELECT src.`region` AS `region`, src.`channel` AS `channel`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
GROUP BY src.`region`, src.`channel`
ORDER BY SUM(src.`amount`) DESC, src.`region` ASC, src.`channel` ASC
LIMIT 3501
-- unfiltered: day, region

-- oracle
SELECT src."REGION" AS "REGION", src."CHANNEL" AS "CHANNEL", SUM(src."AMOUNT") AS "AMOUNT"
FROM "GOLD"."ORDERS" src
GROUP BY src."REGION", src."CHANNEL"
ORDER BY SUM(src."AMOUNT") DESC, src."REGION" ASC, src."CHANNEL" ASC
FETCH FIRST 3501 ROWS ONLY
-- unfiltered: day, region
