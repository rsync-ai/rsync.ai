# settings: {"version":2,"type":"scorecard","roles":{"measure":[{"aggregate":"sum","column":"amount"}],"date":[{"column":"day"}]},"compare":{"days":30},"sparkline":true}

-- postgres
SELECT SUM(CASE WHEN src."day" >= $1 AND src."day" < $2 THEN src."amount" END) AS "amount", SUM(CASE WHEN src."day" >= $3 AND src."day" < $4 THEN src."amount" END) AS "previous"
FROM "gold"."orders" src
WHERE src."day" >= $5 AND src."day" < $6 AND src."region" IN ($7, $8)
LIMIT 10001
-- args: ["2026-09-06" "2026-10-06" "2026-08-07" "2026-09-06" "2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]
-- then
SELECT DATE_TRUNC('day', src."day") AS "day", SUM(src."amount") AS "amount"
FROM "gold"."orders" src
WHERE src."day" >= $1 AND src."day" < $2 AND src."region" IN ($3, $4) AND src."day" >= $5 AND src."day" < $6
GROUP BY DATE_TRUNC('day', src."day")
ORDER BY DATE_TRUNC('day', src."day") ASC
LIMIT 31
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --" "2026-09-06" "2026-10-06"]

-- mysql
SELECT SUM(CASE WHEN src.`day` >= ? AND src.`day` < ? THEN src.`amount` END) AS `amount`, SUM(CASE WHEN src.`day` >= ? AND src.`day` < ? THEN src.`amount` END) AS `previous`
FROM `gold`.`orders` src
WHERE src.`day` >= ? AND src.`day` < ? AND src.`region` IN (?, ?)
LIMIT 10001
-- args: ["2026-09-06" "2026-10-06" "2026-08-07" "2026-09-06" "2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]
-- then
SELECT DATE(src.`day`) AS `day`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
WHERE src.`day` >= ? AND src.`day` < ? AND src.`region` IN (?, ?) AND src.`day` >= ? AND src.`day` < ?
GROUP BY DATE(src.`day`)
ORDER BY DATE(src.`day`) ASC
LIMIT 31
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --" "2026-09-06" "2026-10-06"]

-- sqlserver
SELECT TOP (10001) SUM(CASE WHEN src.[day] >= @p1 AND src.[day] < @p2 THEN src.[amount] END) AS [amount], SUM(CASE WHEN src.[day] >= @p3 AND src.[day] < @p4 THEN src.[amount] END) AS [previous]
FROM [gold].[orders] src
WHERE src.[day] >= @p5 AND src.[day] < @p6 AND src.[region] IN (@p7, @p8)
-- args: ["2026-09-06" "2026-10-06" "2026-08-07" "2026-09-06" "2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]
-- then
SELECT TOP (31) CAST(src.[day] AS date) AS [day], SUM(src.[amount]) AS [amount]
FROM [gold].[orders] src
WHERE src.[day] >= @p1 AND src.[day] < @p2 AND src.[region] IN (@p3, @p4) AND src.[day] >= @p5 AND src.[day] < @p6
GROUP BY CAST(src.[day] AS date)
ORDER BY CAST(src.[day] AS date) ASC
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --" "2026-09-06" "2026-10-06"]

-- bigquery
SELECT SUM(CASE WHEN src.`day` >= '2026-09-06' AND src.`day` < '2026-10-06' THEN src.`amount` END) AS `amount`, SUM(CASE WHEN src.`day` >= '2026-08-07' AND src.`day` < '2026-09-06' THEN src.`amount` END) AS `previous`
FROM `gold`.`orders` src
LIMIT 10001
-- unfiltered: day, region
-- then
SELECT DATE(src.`day`) AS `day`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
WHERE src.`day` >= '2026-09-06' AND src.`day` < '2026-10-06'
GROUP BY DATE(src.`day`)
ORDER BY DATE(src.`day`) ASC
LIMIT 31
-- unfiltered: day, region

-- snowflake
SELECT SUM(CASE WHEN src."DAY" >= '2026-09-06' AND src."DAY" < '2026-10-06' THEN src."AMOUNT" END) AS "AMOUNT", SUM(CASE WHEN src."DAY" >= '2026-08-07' AND src."DAY" < '2026-09-06' THEN src."AMOUNT" END) AS "PREVIOUS"
FROM "GOLD"."ORDERS" src
LIMIT 10001
-- unfiltered: day, region
-- then
SELECT DATE_TRUNC('DAY', src."DAY") AS "DAY", SUM(src."AMOUNT") AS "AMOUNT"
FROM "GOLD"."ORDERS" src
WHERE src."DAY" >= '2026-09-06' AND src."DAY" < '2026-10-06'
GROUP BY DATE_TRUNC('DAY', src."DAY")
ORDER BY DATE_TRUNC('DAY', src."DAY") ASC
LIMIT 31
-- unfiltered: day, region

-- databricks
SELECT SUM(CASE WHEN src.`day` >= :p1 AND src.`day` < :p2 THEN src.`amount` END) AS `amount`, SUM(CASE WHEN src.`day` >= :p3 AND src.`day` < :p4 THEN src.`amount` END) AS `previous`
FROM `gold`.`orders` src
WHERE src.`day` >= :p5 AND src.`day` < :p6 AND src.`region` IN (:p7, :p8)
LIMIT 10001
-- param p1 STRING: "2026-09-06"
-- param p2 STRING: "2026-10-06"
-- param p3 STRING: "2026-08-07"
-- param p4 STRING: "2026-09-06"
-- param p5 STRING: "2026-10-01"
-- param p6 STRING: "2026-10-06"
-- param p7 STRING: "US"
-- param p8 STRING: "EU'); DROP TABLE orders; --"
-- then
SELECT DATE_TRUNC('DAY', src.`day`) AS `day`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
WHERE src.`day` >= :p1 AND src.`day` < :p2 AND src.`region` IN (:p3, :p4) AND src.`day` >= :p5 AND src.`day` < :p6
GROUP BY DATE_TRUNC('DAY', src.`day`)
ORDER BY DATE_TRUNC('DAY', src.`day`) ASC
LIMIT 31
-- param p1 STRING: "2026-10-01"
-- param p2 STRING: "2026-10-06"
-- param p3 STRING: "US"
-- param p4 STRING: "EU'); DROP TABLE orders; --"
-- param p5 STRING: "2026-09-06"
-- param p6 STRING: "2026-10-06"

-- clickhouse
SELECT SUM(CASE WHEN src.`day` >= '2026-09-06' AND src.`day` < '2026-10-06' THEN src.`amount` END) AS `amount`, SUM(CASE WHEN src.`day` >= '2026-08-07' AND src.`day` < '2026-09-06' THEN src.`amount` END) AS `previous`
FROM `gold`.`orders` src
LIMIT 10001
-- unfiltered: day, region
-- then
SELECT toDate(src.`day`) AS `day`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
WHERE src.`day` >= '2026-09-06' AND src.`day` < '2026-10-06'
GROUP BY toDate(src.`day`)
ORDER BY toDate(src.`day`) ASC
LIMIT 31
-- unfiltered: day, region

-- oracle
SELECT SUM(CASE WHEN src."DAY" >= DATE '2026-09-06' AND src."DAY" < DATE '2026-10-06' THEN src."AMOUNT" END) AS "AMOUNT", SUM(CASE WHEN src."DAY" >= DATE '2026-08-07' AND src."DAY" < DATE '2026-09-06' THEN src."AMOUNT" END) AS "PREVIOUS"
FROM "GOLD"."ORDERS" src
FETCH FIRST 10001 ROWS ONLY
-- unfiltered: day, region
-- then
SELECT TRUNC(src."DAY", 'DD') AS "DAY", SUM(src."AMOUNT") AS "AMOUNT"
FROM "GOLD"."ORDERS" src
WHERE src."DAY" >= DATE '2026-09-06' AND src."DAY" < DATE '2026-10-06'
GROUP BY TRUNC(src."DAY", 'DD')
ORDER BY TRUNC(src."DAY", 'DD') ASC
FETCH FIRST 31 ROWS ONLY
-- unfiltered: day, region
