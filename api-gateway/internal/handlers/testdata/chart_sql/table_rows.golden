# settings: {"type":"table","columns":["day","region","amount"],"sort":"x_desc"}

-- postgres
SELECT src."day" AS "day", src."region" AS "region", src."amount" AS "amount"
FROM "gold"."orders" src
WHERE src."day" >= $1 AND src."day" < $2 AND src."region" IN ($3, $4)
ORDER BY src."day" DESC, src."region" ASC, src."amount" ASC
LIMIT 10001
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]
-- when a column cannot be ordered, with the same values
SELECT src."day" AS "day", src."region" AS "region", src."amount" AS "amount"
FROM "gold"."orders" src
WHERE src."day" >= $1 AND src."day" < $2 AND src."region" IN ($3, $4)
ORDER BY src."day" DESC
LIMIT 10001

-- mysql
SELECT src.`day` AS `day`, src.`region` AS `region`, src.`amount` AS `amount`
FROM `gold`.`orders` src
WHERE src.`day` >= ? AND src.`day` < ? AND src.`region` IN (?, ?)
ORDER BY src.`day` DESC, src.`region` ASC, src.`amount` ASC
LIMIT 10001
