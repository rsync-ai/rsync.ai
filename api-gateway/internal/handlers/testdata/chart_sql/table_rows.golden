-- sqlserver
SELECT TOP (10001) src.[day] AS [day], src.[region] AS [region], src.[amount] AS [amount]
FROM [gold].[orders] src
WHERE src.[day] >= @p1 AND src.[day] < @p2 AND src.[region] IN (@p3, @p4)
ORDER BY src.[day] DESC, src.[region] ASC, src.[amount] ASC
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]
