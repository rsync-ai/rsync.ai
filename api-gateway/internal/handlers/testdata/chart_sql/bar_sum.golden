# settings: {"type":"bar","x":{"column":"day"},"measure":{"aggregate":"sum","column":"amount"}}

-- postgres
SELECT src."day" AS "day", SUM(src."amount") AS "amount"
FROM "gold"."orders" src
WHERE src."day" >= $1 AND src."day" < $2 AND src."region" IN ($3, $4)
GROUP BY src."day"
ORDER BY SUM(src."amount") DESC
LIMIT 10001
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- mysql
SELECT src.`day` AS `day`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
WHERE src.`day` >= ? AND src.`day` < ? AND src.`region` IN (?, ?)
GROUP BY src.`day`
ORDER BY SUM(src.`amount`) DESC
LIMIT 10001
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- sqlserver
SELECT TOP (10001) src.[day] AS [day], SUM(src.[amount]) AS [amount]
FROM [gold].[orders] src
WHERE src.[day] >= @p1 AND src.[day] < @p2 AND src.[region] IN (@p3, @p4)
GROUP BY src.[day]
ORDER BY SUM(src.[amount]) DESC
-- args: ["2026-10-01" "2026-10-06" "US" "EU'); DROP TABLE orders; --"]

-- bigquery
SELECT src.`day` AS `day`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
GROUP BY src.`day`
ORDER BY SUM(src.`amount`) DESC
LIMIT 10001
-- unfiltered: day, region

-- snowflake
SELECT src."DAY" AS "DAY", SUM(src."AMOUNT") AS "AMOUNT"
FROM "GOLD"."ORDERS" src
GROUP BY src."DAY"
ORDER BY SUM(src."AMOUNT") DESC
LIMIT 10001
-- unfiltered: day, region

-- databricks
SELECT src.`day` AS `day`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
WHERE src.`day` >= :p1 AND src.`day` < :p2 AND src.`region` IN (:p3, :p4)
GROUP BY src.`day`
ORDER BY SUM(src.`amount`) DESC
LIMIT 10001
-- param p1 STRING: "2026-10-01"
-- param p2 STRING: "2026-10-06"
-- param p3 STRING: "US"
-- param p4 STRING: "EU'); DROP TABLE orders; --"

-- clickhouse
SELECT src.`day` AS `day`, SUM(src.`amount`) AS `amount`
FROM `gold`.`orders` src
GROUP BY src.`day`
ORDER BY SUM(src.`amount`) DESC
LIMIT 10001
-- unfiltered: day, region

-- oracle
SELECT src."DAY" AS "DAY", SUM(src."AMOUNT") AS "AMOUNT"
FROM "GOLD"."ORDERS" src
GROUP BY src."DAY"
ORDER BY SUM(src."AMOUNT") DESC
FETCH FIRST 10001 ROWS ONLY
-- unfiltered: day, region
