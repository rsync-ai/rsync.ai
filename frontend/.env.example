# Frontend Environment Variables - Example Configuration

# Public URLs - Used by browser (client-side)
NEXT_PUBLIC_API_URL=http://localhost:5001

# WebSocket URLs
NEXT_PUBLIC_WS_URL=ws://localhost:5001/ws

# App Configuration
NEXT_PUBLIC_APP_NAME=rsync.ai
NEXT_PUBLIC_ENVIRONMENT=development

# Internal URLs (server-side)
# HOST: use localhost | DOCKER: use the service name (api-gateway)
API_GATEWAY_INTERNAL_URL=http://localhost:5001

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-in-production
